{
  "name": "jobhunt",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"vite\" \"node server/index.ts\"",
    "engine": "node process/engine.ts",
    "typecheck": "tsc --noEmit",
    "phone:audio": "node phone/audio.ts --warm",
    "phone:build": "node phone/build.ts",
    "phone:merge": "node phone/merge.ts",
    "phone:publish": "node phone/publish.ts",
    "my:init": "sh process/tools/my-data.sh init",
    "my:save": "sh process/tools/my-data.sh save"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "lucide-react": "1.70.0",
    "marked": "14.1.4",
    "motion": "14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "10.0.6",
    "playwright-core": "^1.65.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
